name: Build Ansuni APK
on:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - uses: actions/setup-java@v5
        with: { distribution: 'temurin', java-version: '17' }

      - name: Auto Fix All Imports
        run: |
          mkdir -p src/components src/services src/data
          
          # 1. Move files to correct place
          [ -f App.tsx ] && mv App.tsx src/App.tsx || true
          [ -f main.tsx ] && mv main.tsx src/main.tsx || true
          [ -f index.css ] && mv index.css src/index.css || true
          for f in AdminDashboard.tsx AndroidAppModal.tsx HeroSection.tsx Navbar.tsx FavoritesModal.tsx Footer.tsx PoetryCard.tsx PoetryDetailModal.tsx ProjectFilesModal.tsx QuoteCardGeneratorModal.tsx; do [ -f $f ] && mv $f src/components/ || true; done
          for f in ambientAudio.ts androidProjectGenerator.ts audioSpeech.ts storage.ts poetry.ts defaultPoetry.ts; do [ -f $f ] && mv $f src/services/ || true; done
          for f in src/poetry.ts src/defaultPoetry.ts; do [ -f $f ] && mv $f src/services/ || true; done

          # 2. Create src/data/defaultPoetry.ts (yehi missing tha)
          if [ -f src/services/defaultPoetry.ts ]; then
            cp src/services/defaultPoetry.ts src/data/defaultPoetry.ts
          elif [ -f src/services/poetry.ts ]; then
            cp src/services/poetry.ts src/data/defaultPoetry.ts
          else
            echo "Creating dummy defaultPoetry"
            cat > src/data/defaultPoetry.ts << 'EOF'
          export const CATEGORY_LABELS: any = { love: "Love", sad: "Sad", life: "Life" };
          export const MOOD_TAGS: any = ["love", "sad", "life"];
          export const defaultPoetry: any = [];
          export default defaultPoetry;
          EOF
          fi
          
          # Also create poetry.ts in data if needed
          cp src/data/defaultPoetry.ts src/data/poetry.ts || true
          cp src/data/defaultPoetry.ts src/services/poetry.ts || true
          
          # 3. Fix all wrong import paths in components
          sed -i "s|\.\./data/defaultPoetry|../data/defaultPoetry|g" src/components/*.tsx || true
          sed -i "s|\.\./\.\./data/defaultPoetry|../data/defaultPoetry|g" src/components/*.tsx || true
          sed -i "s|from '\.\./data/|from '../data/|g" src/components/*.tsx || true
          sed -i "s|from \"\.\./data/|from \"../data/|g" src/components/*.tsx || true
          
          # Create index.html and vite.config if missing
          cat > index.html << 'EOF'
          <!DOCTYPE html><html><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Ansuni Ankahi Bate</title></head><body><div id="root"></div><script type="module" src="/src/main.tsx"></script></body></html>
          EOF
          cat > vite.config.ts << 'EOF'
          import { defineConfig } from 'vite'
          import react from '@vitejs/plugin-react'
          export default defineConfig({ plugins: [react()] })
          EOF
          cat > src/main.tsx << 'EOF'
          import React from 'react'
          import ReactDOM from 'react-dom/client'
          import App from './App.tsx'
          import './index.css'
          ReactDOM.createRoot(document.getElementById('root')!).render(<React.StrictMode><App /></React.StrictMode>)
          EOF
          
          echo "=== FINAL STRUCTURE ==="
          find src -type f | sort
          echo "=== Checking PoetryDetailModal ==="
          head -20 src/components/PoetryDetailModal.tsx

      - name: Build
        run: |
          npm install --legacy-peer-deps
          npm install --legacy-peer-deps @capacitor/core @capacitor/cli @capacitor/android @vitejs/plugin-react
          npx vite build
          npx cap init "Ansuni Ankahi Bate" com.ansuni.ankahi --web-dir=dist
          npx cap add android
          npx cap copy android
          cd android && chmod +x gradlew && ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: AnsuniAnkahiBate-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
